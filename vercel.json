{
  "version": 2,
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/index.js": {
      "maxDuration": 300
    }
  },
  "crons": [
    {
      "path": "/api/cron/auto-notificacao-envio",
      "schedule": "30 8 * * 1-5"
    },
    {
      "path": "/api/cron/auto-notificacao-envio",
      "schedule": "0 9 * * 1-5"
    },
    {
      "path": "/api/cron/auto-notificacao-envio-em-transporte",
      "schedule": "30 9 * * 1-5"
    },
    {
      "path": "/api/cron/auto-notificacao-envio-em-transporte",
      "schedule": "45 9 * * 1-5"
    },
    {
      "path": "/api/cron/auto-notificacao-incidencia",
      "schedule": "30,50 13 * * 1-5"
    },
    {
      "path": "/api/cron/auto-notificacao-incidencia",
      "schedule": "0,20,30,50 14 * * 1-5"
    },
    {
      "path": "/api/cron/auto-notificacao-incidencia",
      "schedule": "0,20,30,50 15 * * 1-5"
    },
    {
      "path": "/api/cron/auto-notificacao-incidencia",
      "schedule": "0,20,30,50 16 * * 1-5"
    },
    {
      "path": "/api/cron/auto-notificacao-incidencia",
      "schedule": "0,20,30,50 17 * * 1-5"
    },
    {
      "path": "/api/cron/auto-notificacao-incidencia",
      "schedule": "0,20,30,50 18 * * 1-5"
    },
    {
      "path": "/api/cron/auto-notificacao-incidencia",
      "schedule": "0,20 19 * * 1-5"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api/index.js"
    }
  ]
}
